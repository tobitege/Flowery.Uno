<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />
    <PackageVersion Include="Uno.UI" Version="$(UnoVersion)" />
    <PackageVersion Include="Uno.Toolkit.WinUI" Version="8.4.2" />
    <PackageVersion Include="Uno.Toolkit.Skia.WinUI" Version="8.4.2" />
    <PackageVersion Include="Uno.WinUI.DevServer" Version="$(UnoVersion)" />

    <PackageVersion Include="MSTest" Version="4.2.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.2.2" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.2.2" />
    <PackageVersion Include="MSTest.Analyzers" Version="4.2.2" />
    <PackageVersion Include="Combinatorial.MSTest" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.2.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.2.2" />

    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.7" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.93.0" />
    <PackageVersion Include="Uno.WinUI.Graphics2DSK" Version="$(UnoVersion)" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="IdentityModel.OidcClient" Version="6.0.0" />
  </ItemGroup>
</Project>
