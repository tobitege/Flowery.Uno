<UserControl
    x:Class="Flowery.Uno.Photos.Views.CollectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:daisy="using:Flowery.Controls"
    xmlns:views="using:Flowery.Uno.Photos.Views">

    <Grid RowDefinitions="Auto,*" DataContext="{x:Bind Localization, Mode=OneWay}">
        <Grid Padding="28,18,20,10" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock x:Name="TitleText" Style="{StaticResource PhotosPageTitleTextStyle}" />
                <TextBlock x:Name="CountText"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource DaisyBaseContentBrush}"
                           daisy:FlowerySizeManager.ResponsiveFont="Secondary" />
            </StackPanel>
            <daisy:DaisyButton x:Name="PrimaryActionButton"
                               Grid.Column="1"
                               Variant="Primary"
                               IconSymbol="Add"
                               VerticalAlignment="Center"
                               Click="PrimaryActionButton_Click" />
        </Grid>

        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      Padding="24,4,24,24"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="Repeater" ElementPrepared="Repeater_ElementPrepared">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="210"
                                       MinItemHeight="236"
                                       MinRowSpacing="18"
                                       MinColumnSpacing="18"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <views:CollectionCard />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    MaxWidth="420"
                    Visibility="Collapsed">
            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                <Path x:Name="EmptyIcon" Data="{StaticResource PhotosIconAlbum}" Fill="{ThemeResource DaisyPrimaryBrush}" Opacity="0.85" />
            </Viewbox>
            <TextBlock x:Name="EmptyTitle"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource DaisyBaseContentBrush}" />
            <TextBlock x:Name="EmptyText"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource DaisyBaseContentBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
