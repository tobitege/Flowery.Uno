<Project Sdk="Uno.Sdk/6.7.30">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android36.0;net10.0-windows10.0.19041;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!-- Rider reads this list before Uno.Sdk filters it: list Windows only when building on Windows -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0-android36.0;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(FloweryExcludeAndroid)' == 'true'">net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!-- iOS needs Xcode: only macOS hosts see the target -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <UnoVersion>6.7.135</UnoVersion>
    <UnoSingleProject>true</UnoSingleProject>


    <!-- NuGet Package Properties -->
    <PackageId>Flowery.Uno</PackageId>
    <Authors>tobitege</Authors>
    <Description>Themed UI components for Uno Platform</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tobitege/Flowery.Uno</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tobitege/Flowery.Uno</RepositoryUrl>
    <PackageTags>uno;winui;theme;ui;xaml</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Required for WinRT ABI compatibility with generic collections (e.g., IReadOnlyList<string>) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Include assets when referenced as ProjectReference / PackageReference (Uno control libraries) -->
    <GenerateLibraryLayout>true</GenerateLibraryLayout>

    <!-- Library, not app -->
    <OutputType>Library</OutputType>

    <IsWindowsTarget>$([System.String]::Copy('$(TargetFramework)').Contains('-windows'))</IsWindowsTarget>
    <IsDesktopTarget>$([System.String]::Copy('$(TargetFramework)').Contains('-desktop'))</IsDesktopTarget>
  </PropertyGroup>

  <!-- iOS uses the Skia renderer (UIKit host); other targets keep their current renderer -->
  <PropertyGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-ios'))">
    <UnoFeatures>$(UnoFeatures);SkiaRenderer</UnoFeatures>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindowsTarget)' == 'True'">
    <!-- Required for WinUI on Windows -->
    <RuntimeIdentifier>$(FloweryWindowsRuntimeIdentifier)</RuntimeIdentifier>
    <Platform>$(FloweryWindowsPlatform)</Platform>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>

    <!-- Workaround for UNOB0008: allows building WinUI class library with dotnet build when XAML is present -->
    <UnoDisableValidateWinAppSDK3548>true</UnoDisableValidateWinAppSDK3548>
  </PropertyGroup>

  <!-- <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true' Or '$(BuildingInsideVisualStudio)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <TargetFrameworks>net10.0-windows10.0.19041</TargetFrameworks>
  </PropertyGroup> -->

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
    <EmbeddedResource Include="WasmScripts\flowery-carousel-gl.js" />
    <Content Include="Assets\Patterns\**\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="NormalizeAndroidLibraryLayoutPackagePaths"
          AfterTargets="_UnoIncludeLibraryAssets"
          Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <ItemGroup>
      <_FloweryAndroidLayoutPackageFile Include="@(TfmSpecificPackageFile)"
                                        Condition="$([System.String]::Copy('%(TfmSpecificPackageFile.PackagePath)').StartsWith('lib\$(TargetFramework)$(TargetPlatformVersion)\'))" />
      <TfmSpecificPackageFile Remove="@(_FloweryAndroidLayoutPackageFile)" />
      <TfmSpecificPackageFile Include="@(_FloweryAndroidLayoutPackageFile)">
        <PackagePath>$([System.String]::Copy('%(_FloweryAndroidLayoutPackageFile.PackagePath)').Replace('lib\$(TargetFramework)$(TargetPlatformVersion)\', 'lib\$(TargetFramework)\'))</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android' Or '$(TargetPlatformIdentifier)' == 'browserwasm'">
    <!-- Layout rounding is supported on Windows and Skia Desktop, but not these native API surfaces. -->
    <ExcludeXamlNamespaces Include="rounding" />
  </ItemGroup>

  <!-- SkiaSharp for cross-platform image processing and effects -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Uno.Toolkit.Skia.WinUI" />
  </ItemGroup>

</Project>
