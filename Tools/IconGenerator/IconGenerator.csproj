<Project Sdk="Uno.Sdk/6.7.30">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <UnoVersion>6.7.135</UnoVersion>
    <UnoSingleProject>true</UnoSingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <!-- Reference the Flowery.Uno library to use its icon export -->
  <ItemGroup>
    <ProjectReference Include="..\..\Flowery.Uno\Flowery.Uno.csproj" />
  </ItemGroup>

</Project>

